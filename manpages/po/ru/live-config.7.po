#, no-wrap
msgid "B<LIVE_XRDP_MODE>=B<relaxed>|hardened|disabled"
msgstr "B<LIVE_XRDP_MODE>=B<relaxed>|hardened|disabled"

#. type: Plain text
#: en/live-config.7:219
msgid ""
"This variable corresponds to the 'B<live-config.xrdp-mode>=...' parameter."
msgstr "Эта переменная соответствует параметру 'B<live-config.xrdp-mode>=...'."

#. type: IP
#: en/live-config.7:219
#, no-wrap
msgid "B<LIVE_X11_MODE>=B<relaxed>|hardened"
msgstr "B<LIVE_X11_MODE>=B<relaxed>|hardened"

#. type: Plain text
#: en/live-config.7:221
msgid ""
"This variable corresponds to the 'B<live-config.x11-mode>=...' parameter."
msgstr "Эта переменная соответствует параметру 'B<live-config.x11-mode>=...'."

#. type: IP
#: en/live-config.7:221
#, no-wrap
msgid "B<LIVE_ISSUE_PASSWORD_HINTS>=B<true>|false"
msgstr "B<LIVE_ISSUE_PASSWORD_HINTS>=B<true>|false"

#. type: Plain text
#: en/live-config.7:223
msgid ""
"This variable corresponds to the 'B<live-config.issue-password-hints>=...' "
"parameter."
msgstr ""
"Эта переменная соответствует параметру 'B<live-config.issue-password-"
"hints>=...'."

#. type: IP
#: en/live-config.7:223
#, no-wrap
msgid "B<LIVE_LOCKSCREEN_MODE>=B<relaxed>|hardened"
msgstr "B<LIVE_LOCKSCREEN_MODE>=B<relaxed>|hardened"

#. type: Plain text
#: en/live-config.7:225
msgid ""
"This variable corresponds to the 'B<live-config.lockscreen-mode>=...' "
"parameter."
msgstr ""
"Эта переменная соответствует параметру 'B<live-config.lockscreen-mode>=...'."

#. type: IP
#: en/live-config.7:225
#, no-wrap
msgid "B<LIVE_LOCALES>=I<LOCALE1>,I<LOCALE2> ... I<LOCALEn>"
msgstr "B<LIVE_LOCALES>=I<ЛОКАЛЬ1>,I<ЛОКАЛЬ2> ... I<ЛОКАЛЬn>"

#. type: Plain text
#: en/live-config.7:227
msgid ""
"This variable corresponds to the 'B<live-"
"config.locales>=I<LOCALE1>,I<LOCALE2> ... I<LOCALEn>' parameter."
msgstr ""
"Эта переменная соответствует параметру 'B<live-"
"config.locales>=I<ЛОКАЛЬ1>,I<ЛОКАЛЬ2> ... I<ЛОКАЛЬn>'."

#. type: IP
#: en/live-config.7:227
#, no-wrap
msgid "B<LIVE_TIMEZONE>=I<TIMEZONE>"
msgstr "B<LIVE_TIMEZONE>=I<ЧАСОВОЙ_ПОЯС>"

#. type: Plain text
#: en/live-config.7:229
msgid ""
"This variable corresponds to the 'B<live-config.timezone>=I<TIMEZONE>' "
"parameter."
msgstr ""
"Эта переменная соответствует параметру 'B<live-"
"config.timezone>=I<ЧАСОВОЙ_ПОЯС>'."


#: en/live-config.7:388
#, no-wrap
msgid "B</live/config-hooks/*>"
msgstr "B</live/config-hooks/*>"

#. type: IP
#: en/live-config.7:389
#, no-wrap
msgid "B<live/config-hooks/*>"
msgstr "B<live/config-hooks/*>"

#. type: IP
#: en/live-config.7:390
#, no-wrap
msgid "B</live/config-preseed/*>"
msgstr "B</live/config-preseed/*>"

#. type: IP
#: en/live-config.7:391
#, no-wrap
msgid "B<live/config-preseed/* >"
msgstr "B<live/config-preseed/* >"


msgstr ""

#. type: IP
#: en/live-config.7:209
#, no-wrap
msgid "B<LIVE_SUDO_MODE>=B<passwordless>|password|disabled"
msgstr ""

#. type: Plain text
#: en/live-config.7:211
msgid ""
"This variable corresponds to the 'B<live-config.sudo-mode>=...' parameter. "
"If unset, MiniOS keeps the historical passwordless sudo behavior. Use "
"B<password> to require the live user's password for sudo, or B<disabled> to "
"remove the MiniOS sudo grant and sudo group membership during user creation."
msgstr ""

#. type: IP
#: en/live-config.7:211
#, no-wrap

#!/bin/bash
# Author: sfs <https://puppyrus.org>
# Author: crims0n <https://minios.dev>

usage() {
    cat <<USAGE
Builds a common dpkg database from all bundles
    Usage:   $0 [bundles mount points location] [optional: changes location]
    Example: $0 /run/initramfs/memory/bundles /run/initramfs/memory/changes
USAGE
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    '')
        usage >&2
        exit 1
        ;;
esac
BUNDLES=$1
CHANGES=${2:-}
DPKG_DIR=/var/lib/dpkg
DPKG_STATUS_FILE=$DPKG_DIR/status
MERGE_HELPER=/usr/lib/live/minios-update-dpkg-merge

[ -d "$BUNDLES" ] || {
    echo "Bundles directory not found: $BUNDLES" >&2
    exit 1
}
if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root!" >&2
    exit 1
fi
[ -d "$DPKG_DIR" ] || exit 0
[ -x "$MERGE_HELPER" ] || {
    echo "Missing dpkg merge helper: $MERGE_HELPER" >&2
    exit 1
}
command -v flock >/dev/null 2>&1 || {
    echo "Required command not found: flock" >&2
    exit 1
}

export HOME=/root
export LC_ALL=C

. /usr/lib/live/config.sh
if minios_debug_enabled; then
    umask 077
    mkdir -p /var/log/minios
    touch /var/log/minios/minios-update-dpkg.trace.log
    chmod 600 /var/log/minios/minios-update-dpkg.trace.log
    exec 19>/var/log/minios/minios-update-dpkg.trace.log
    BASH_XTRACEFD=19
    set -x
fi
mkdir -p /run/lock

# Boot-time live-config and runtime sb changes can request a refresh at the
# same time.  Never let two writers rebuild /var/lib/dpkg/status concurrently.
exec 9>/run/lock/minios-update-dpkg.lock
flock -x 9 || exit 1

TEMP_STATOVERRIDE=$(mktemp /run/statoverride.XXXXXX) || exit 1
TEMP_MODULE_STATUS=$(mktemp /run/dpkg_module_status.XXXXXX) || exit 1
TEMP_STATUS=$(mktemp /run/dpkg_status.XXXXXX) || exit 1
TEMP_BASE=$(mktemp /run/dpkg_base.XXXXXX) || exit 1
TEMP_INSTALL=""
STATE_DIR=""
BASELINE_STATUS=""

cleanup() {
    rm -f -- "$TEMP_STATOVERRIDE" "$TEMP_MODULE_STATUS" "$TEMP_STATUS" "$TEMP_BASE"
    [ -z "$TEMP_INSTALL" ] || rm -f -- "$TEMP_INSTALL"
}
trap cleanup EXIT HUP INT TERM

atomic_replace() {
    local SOURCE=$1 TARGET=$2 MODE=$3 DIR
    DIR=$(dirname -- "$TARGET")
    TEMP_INSTALL=$(mktemp "$DIR/.minios-dpkg.XXXXXX") || return 1
    cat -- "$SOURCE" >"$TEMP_INSTALL" || return 1
    chmod "$MODE" "$TEMP_INSTALL" || return 1
    chown 0:0 "$TEMP_INSTALL" || return 1
    mv -f -- "$TEMP_INSTALL" "$TARGET" || return 1
    TEMP_INSTALL=""
}

# The baseline contains only records reconstructed from currently mounted
# modules.  Comparing the writable status with this baseline on the next run
# separates real session dpkg changes from the previously synthesized database.
if [ -n "$CHANGES" ] && [ -d "$CHANGES" ]; then
    STATE_DIR="$CHANGES/var/lib/dpkg/.minios-merge"
    if [ -L "$STATE_DIR" ]; then
        echo "Refusing symlink dpkg merge state directory: $STATE_DIR" >&2
        exit 1
    fi
    mkdir -p -- "$STATE_DIR" || exit 1
    [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] || exit 1
    BASELINE_STATUS="$STATE_DIR/status.base"
fi

# Preserve the historical statoverride merge behavior.  Unlike status, its
# records are not package inventory and do not produce stale installed-package
# entries when a module disappears.
: >"$TEMP_STATOVERRIDE"
for FILE in "$BUNDLES"/*/var/lib/dpkg/statoverride; do
    [ -f "$FILE" ] && cat -- "$FILE" >>"$TEMP_STATOVERRIDE"
done
if [ -n "$CHANGES" ] && [ -f "$CHANGES/var/lib/dpkg/statoverride" ]; then
    cat -- "$CHANGES/var/lib/dpkg/statoverride" >>"$TEMP_STATOVERRIDE"
fi
sort -u "$TEMP_STATOVERRIDE" >"$TEMP_STATOVERRIDE.sorted" || exit 1
mv -f -- "$TEMP_STATOVERRIDE.sorted" "$TEMP_STATOVERRIDE" || exit 1
atomic_replace "$TEMP_STATOVERRIDE" "$DPKG_DIR/statoverride" 0644 || exit 1

: >"$TEMP_MODULE_STATUS"
for FILE in "$BUNDLES"/*/var/lib/dpkg/status; do
    [ -f "$FILE" ] && cat -- "$FILE" >>"$TEMP_MODULE_STATUS"
done

CURRENT_STATUS=/dev/null
CHANGES_INFO=/dev/null
PREVIOUS_BASE=/dev/null
if [ -n "$CHANGES" ] && [ -f "$CHANGES/var/lib/dpkg/status" ]; then
    CURRENT_STATUS="$CHANGES/var/lib/dpkg/status"
fi
if [ -n "$CHANGES" ] && [ -d "$CHANGES/var/lib/dpkg/info" ]; then
    CHANGES_INFO="$CHANGES/var/lib/dpkg/info"
fi
if [ -n "$BASELINE_STATUS" ] && [ -f "$BASELINE_STATUS" ]; then
    PREVIOUS_BASE="$BASELINE_STATUS"
fi

"$MERGE_HELPER" "$TEMP_MODULE_STATUS" "$CURRENT_STATUS" "$PREVIOUS_BASE" \
    "$CHANGES_INFO" "$TEMP_BASE" "$TEMP_STATUS" || exit 1

atomic_replace "$TEMP_STATUS" "$DPKG_STATUS_FILE" 0644 || exit 1
if [ -n "$BASELINE_STATUS" ]; then
    atomic_replace "$TEMP_BASE" "$BASELINE_STATUS" 0600 || exit 1
fi
